<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.5//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_5.dtd'>
<nta>
  <declaration>// tau(tandem_2_batch_norestart): EG -&gt; NTA (Definitions 3.1 to 3.5)
int[0,5] q1 = 0;
int[0,1] a1 = 1;
int[0,5] q2 = 0;
int[0,1] a2 = 1;
int[0,3] dep = 0;
broadcast chan sched_e4, sched_e5, sched_e7, sched_e8, sched_e9;
chan fire_e0a, fire_e0b, fire_e0c, fire_e4, fire_e5, fire_e7, fire_e8, fire_e9;
chan priority fire_e0a, fire_e0b, fire_e0c, fire_e5, fire_e8 &lt; fire_e9 &lt; fire_e7 &lt; fire_e4;</declaration>
  <template>
    <name>W_e4</name>
    <declaration>clock x;</declaration>
    <location id="id0" x="0" y="0">
      <name x="-10" y="-30">idle</name>
    </location>
    <location id="id1" x="200" y="0">
      <name x="190" y="-30">active</name>
      <label kind="invariant" x="190" y="20">x &lt;= 0</label>
    </location>
    <init ref="id0"/>
    <transition>
      <source ref="id0"/>
      <target ref="id1"/>
      <label kind="guard">a1 &gt;= 1</label>
      <label kind="synchronisation">sched_e4?</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="id0"/>
      <target ref="id0"/>
      <label kind="guard">a1 &lt; 1</label>
      <label kind="synchronisation">sched_e4?</label>
      <nail x="-40" y="40"/>
      <nail x="40" y="40"/>
    </transition>
    <transition>
      <source ref="id1"/>
      <target ref="id0"/>
      <label kind="guard">x &gt;= 0</label>
      <label kind="synchronisation">fire_e4!</label>
    </transition>
  </template>
  <template>
    <name>W_e5</name>
    <declaration>clock x;</declaration>
    <location id="id2" x="0" y="0">
      <name x="-10" y="-30">idle</name>
    </location>
    <location id="id3" x="200" y="0">
      <name x="190" y="-30">active</name>
      <label kind="invariant" x="190" y="20">x &lt;= 5</label>
    </location>
    <init ref="id2"/>
    <transition>
      <source ref="id2"/>
      <target ref="id3"/>
      <label kind="synchronisation">sched_e5?</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="id3"/>
      <target ref="id2"/>
      <label kind="guard">x &gt;= 3</label>
      <label kind="synchronisation">fire_e5!</label>
    </transition>
  </template>
  <template>
    <name>W_e7</name>
    <declaration>clock x;</declaration>
    <location id="id4" x="0" y="0">
      <name x="-10" y="-30">idle</name>
    </location>
    <location id="id5" x="200" y="0">
      <name x="190" y="-30">active</name>
      <label kind="invariant" x="190" y="20">x &lt;= 0</label>
    </location>
    <init ref="id4"/>
    <transition>
      <source ref="id4"/>
      <target ref="id5"/>
      <label kind="guard">a2 &gt;= 1</label>
      <label kind="synchronisation">sched_e7?</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="id4"/>
      <target ref="id4"/>
      <label kind="guard">a2 &lt; 1</label>
      <label kind="synchronisation">sched_e7?</label>
      <nail x="-40" y="40"/>
      <nail x="40" y="40"/>
    </transition>
    <transition>
      <source ref="id5"/>
      <target ref="id4"/>
      <label kind="guard">x &gt;= 0</label>
      <label kind="synchronisation">fire_e7!</label>
    </transition>
  </template>
  <template>
    <name>W_e8</name>
    <declaration>clock x;</declaration>
    <location id="id6" x="0" y="0">
      <name x="-10" y="-30">idle</name>
    </location>
    <location id="id7" x="200" y="0">
      <name x="190" y="-30">active</name>
      <label kind="invariant" x="190" y="20">x &lt;= 5</label>
    </location>
    <init ref="id6"/>
    <transition>
      <source ref="id6"/>
      <target ref="id7"/>
      <label kind="synchronisation">sched_e8?</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="id7"/>
      <target ref="id6"/>
      <label kind="guard">x &gt;= 3</label>
      <label kind="synchronisation">fire_e8!</label>
    </transition>
  </template>
  <template>
    <name>W_e9</name>
    <declaration>clock x;</declaration>
    <location id="id8" x="0" y="0">
      <name x="-10" y="-30">idle</name>
    </location>
    <location id="id9" x="200" y="0">
      <name x="190" y="-30">active</name>
      <label kind="invariant" x="190" y="20">x &lt;= 0</label>
    </location>
    <init ref="id8"/>
    <transition>
      <source ref="id8"/>
      <target ref="id9"/>
      <label kind="guard">q2 &gt;= 1 &amp;&amp; a2 &gt;= 1</label>
      <label kind="synchronisation">sched_e9?</label>
      <label kind="assignment">x = 0</label>
    </transition>
    <transition>
      <source ref="id8"/>
      <target ref="id8"/>
      <label kind="guard">q2 &lt; 1 || a2 &lt; 1</label>
      <label kind="synchronisation">sched_e9?</label>
      <nail x="-40" y="40"/>
      <nail x="40" y="40"/>
    </transition>
    <transition>
      <source ref="id9"/>
      <target ref="id8"/>
      <label kind="guard">x &gt;= 0</label>
      <label kind="synchronisation">fire_e9!</label>
    </transition>
  </template>
  <template>
    <name>W_e0a</name>
    <declaration>clock x;</declaration>
    <location id="id10" x="0" y="0">
      <name x="-10" y="-30">active</name>
      <label kind="invariant" x="-10" y="20">x &lt;= 0</label>
    </location>
    <location id="id11" x="200" y="0">
      <name x="190" y="-30">done</name>
    </location>
    <init ref="id10"/>
    <transition>
      <source ref="id10"/>
      <target ref="id11"/>
      <label kind="guard">x &gt;= 0</label>
      <label kind="synchronisation">fire_e0a!</label>
    </transition>
  </template>
  <template>
    <name>W_e0b</name>
    <declaration>clock x;</declaration>
    <location id="id12" x="0" y="0">
      <name x="-10" y="-30">active</name>
      <label kind="invariant" x="-10" y="20">x &lt;= 4</label>
    </location>
    <location id="id13" x="200" y="0">
      <name x="190" y="-30">done</name>
    </location>
    <init ref="id12"/>
    <transition>
      <source ref="id12"/>
      <target ref="id13"/>
      <label kind="guard">x &gt;= 4</label>
      <label kind="synchronisation">fire_e0b!</label>
    </transition>
  </template>
  <template>
    <name>W_e0c</name>
    <declaration>clock x;</declaration>
    <location id="id14" x="0" y="0">
      <name x="-10" y="-30">active</name>
      <label kind="invariant" x="-10" y="20">x &lt;= 8</label>
    </location>
    <location id="id15" x="200" y="0">
      <name x="190" y="-30">done</name>
    </location>
    <init ref="id14"/>
    <transition>
      <source ref="id14"/>
      <target ref="id15"/>
      <label kind="guard">x &gt;= 8</label>
      <label kind="synchronisation">fire_e0c!</label>
    </transition>
  </template>
  <template>
    <name>SU</name>
    <location id="id16" x="0" y="0">
      <name x="-10" y="-30">wait</name>
    </location>
    <location id="id17" x="200" y="0">
      <name x="190" y="-30">apply_Arrive_0</name>
      <committed/>
    </location>
    <location id="id18" x="400" y="0">
      <name x="390" y="-30">apply_Start1_0</name>
      <committed/>
    </location>
    <location id="id19" x="600" y="0">
      <name x="590" y="-30">apply_Finish1_0</name>
      <committed/>
    </location>
    <location id="id20" x="800" y="0">
      <name x="790" y="-30">apply_Start2_0</name>
      <committed/>
    </location>
    <location id="id21" x="1000" y="0">
      <name x="990" y="-30">apply_Finish2_0</name>
      <committed/>
    </location>
    <init ref="id16"/>
    <transition>
      <source ref="id16"/>
      <target ref="id17"/>
      <label kind="synchronisation">fire_e0a?</label>
      <label kind="assignment">q1 = q1 + 1 &gt; 5 ? 5 : q1 + 1</label>
    </transition>
    <transition>
      <source ref="id16"/>
      <target ref="id17"/>
      <label kind="synchronisation">fire_e0b?</label>
      <label kind="assignment">q1 = q1 + 1 &gt; 5 ? 5 : q1 + 1</label>
    </transition>
    <transition>
      <source ref="id16"/>
      <target ref="id17"/>
      <label kind="synchronisation">fire_e0c?</label>
      <label kind="assignment">q1 = q1 + 1 &gt; 5 ? 5 : q1 + 1</label>
    </transition>
    <transition>
      <source ref="id17"/>
      <target ref="id16"/>
      <label kind="synchronisation">sched_e4!</label>
    </transition>
    <transition>
      <source ref="id16"/>
      <target ref="id18"/>
      <label kind="synchronisation">fire_e4?</label>
      <label kind="assignment">q1 = q1 - 1, a1 = a1 - 1</label>
    </transition>
    <transition>
      <source ref="id18"/>
      <target ref="id16"/>
      <label kind="synchronisation">sched_e5!</label>
    </transition>
    <transition>
      <source ref="id16"/>
      <target ref="id19"/>
      <label kind="synchronisation">fire_e5?</label>
      <label kind="assignment">a1 = a1 + 1 &gt; 1 ? 1 : a1 + 1, q2 = q2 + 1 &gt; 5 ? 5 : q2 + 1</label>
    </transition>
    <transition>
      <source ref="id19"/>
      <target ref="id16"/>
      <label kind="synchronisation">sched_e7!</label>
    </transition>
    <transition>
      <source ref="id16"/>
      <target ref="id20"/>
      <label kind="synchronisation">fire_e7?</label>
      <label kind="assignment">q2 = q2 - 1, a2 = a2 - 1</label>
    </transition>
    <transition>
      <source ref="id16"/>
      <target ref="id20"/>
      <label kind="synchronisation">fire_e9?</label>
      <label kind="assignment">q2 = q2 - 1, a2 = a2 - 1</label>
    </transition>
    <transition>
      <source ref="id20"/>
      <target ref="id16"/>
      <label kind="synchronisation">sched_e8!</label>
    </transition>
    <transition>
      <source ref="id16"/>
      <target ref="id21"/>
      <label kind="synchronisation">fire_e8?</label>
      <label kind="assignment">a2 = a2 + 1 &gt; 1 ? 1 : a2 + 1, dep = dep + 1 &gt; 3 ? 3 : dep + 1</label>
    </transition>
    <transition>
      <source ref="id21"/>
      <target ref="id16"/>
      <label kind="synchronisation">sched_e9!</label>
    </transition>
  </template>
  <system>system W_e4, W_e5, W_e7, W_e8, W_e9, W_e0a, W_e0b, W_e0c, SU;</system>
</nta>
